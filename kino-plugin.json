{
  "id": "xuper",
  "name": "Xuper",
  "version": "2.0.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "hosts": [
    "api.themoviedb.org",
    "raw.githubusercontent.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "channels",
    "migrate"
  ],
  "settings": [
    {
      "key": "account",
      "label": "Cuenta",
      "type": "section",
      "hint": "Opcional. Sin cuenta accedes al catálogo con sesión anónima."
    },
    {
      "key": "email",
      "label": "Correo electrónico",
      "type": "text"
    },
    {
      "key": "password",
      "label": "Contraseña",
      "type": "password"
    },
    {
      "key": "status",
      "label": "Estado de sesión",
      "type": "status"
    },
    {
      "key": "login",
      "label": "Iniciar sesión",
      "type": "action"
    },
    {
      "key": "logout",
      "label": "Cerrar sesión",
      "type": "action",
      "confirm": "¿Cerrar sesión de tu cuenta Xuper?"
    },
    {
      "key": "switchSeed",
      "label": "Cambiar semilla",
      "type": "action",
      "hint": "Prueba otra sesión de respaldo si esta va mal"
    },
    {
      "key": "refreshSeeds",
      "label": "Actualizar semillas",
      "type": "action",
      "hint": "Vuelve a descargar las sesiones de respaldo"
    }
  ],
  "streamHosts": "any",
  "liveStreamHosts": "any"
}

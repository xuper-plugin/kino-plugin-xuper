{
  "id": "xuper",
  "name": "Xuper",
  "version": "2.2.18",
  "apiVersion": 6,
  "entry": "plugin.js",
  "icon": "icon.png",
  "hosts": [
    "oogoy.f30c96w8.com",
    "osuhk.m3x8o50te.com",
    "api.themoviedb.org",
    "raw.githubusercontent.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "channels",
    "migrate",
    "scopedSearch"
  ],
  "telemetry": "verbose",
  "settings": [
    {
      "key": "account",
      "label": "Cuenta",
      "type": "section",
      "hint": "Opcional. Sin cuenta accedes al catálogo con sesión anónima."
    },
    {
      "key": "email",
      "label": "Correo electrónico",
      "type": "text"
    },
    {
      "key": "password",
      "label": "Contraseña",
      "type": "password"
    },
    {
      "key": "status",
      "label": "Estado de sesión",
      "type": "status"
    },
    {
      "key": "login",
      "label": "Iniciar sesión",
      "type": "action"
    },
    {
      "key": "logout",
      "label": "Cerrar sesión",
      "type": "action",
      "confirm": "¿Cerrar sesión de tu cuenta Xuper?"
    },
    {
      "key": "useSharedAccount",
      "label": "Usar cuenta compartida",
      "type": "toggle",
      "hint": "Muchas personas la usan; puede cerrar la sesión de otra."
    },
    {
      "key": "createAccount",
      "label": "Crear cuenta",
      "type": "section",
      "hint": "Guarda tu correo y toca Enviar código; luego guarda código y contraseña."
    },
    {
      "key": "verifyCode",
      "label": "Código de verificación",
      "type": "text",
      "hint": "El código que llega a tu correo"
    },
    {
      "key": "sendCode",
      "label": "Enviar código",
      "type": "action"
    },
    {
      "key": "register",
      "label": "Crear cuenta",
      "type": "action"
    },
    {
      "key": "seeds",
      "label": "Semillas",
      "type": "section",
      "hint": "Sesiones de respaldo para cuando tu zona está bloqueada."
    },
    {
      "key": "autoRefreshSeeds",
      "label": "Actualizar semillas automáticamente",
      "type": "toggle",
      "default": true,
      "hint": "Solo sin cuenta y con la zona bloqueada"
    },
    {
      "key": "switchSeed",
      "label": "Cambiar semilla",
      "type": "action",
      "hint": "Prueba otra sesión de respaldo si esta va mal"
    },
    {
      "key": "refreshSeeds",
      "label": "Actualizar semillas",
      "type": "action",
      "hint": "Vuelve a descargar las sesiones de respaldo"
    }
,
    {
      "key": "home",
      "label": "Inicio",
      "type": "section",
      "hint": "Una fila con los canales en vivo de tu país al final de Inicio."
    },
    {
      "key": "homeCountry",
      "label": "Canales en vivo de tu país",
      "type": "select",
